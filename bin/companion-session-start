#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from pathlib import Path

project_root = Path("/home/ghk/investment-home")
sys.path.insert(0, str(project_root))

from companion.core import Companion  # noqa: E402


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if event.get("hook_event_name") != "SessionStart":
            return 0
        companion = Companion(project_root)
        brief = companion.session_brief()
        output = {
            "continue": True,
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": brief["text"],
            },
        }
    except Exception as exc:
        output = {
            "continue": True,
            "systemMessage": f"Investment Companion session brief unavailable: {type(exc).__name__}: {exc}",
        }
    print(json.dumps(output, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
