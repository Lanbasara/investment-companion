#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

project_root = Path(__file__).resolve().parents[1]
workspace_root = Path(os.environ.get("COMPANION_ROOT", project_root)).expanduser().resolve()
runtime_marker = workspace_root / ".state" / "runtime-code-root"
configured_runtime = os.environ.get("COMPANION_RUNTIME_ROOT")
if not configured_runtime and runtime_marker.is_file():
    configured_runtime = runtime_marker.read_text(encoding="utf-8").strip()
runtime_root = Path(configured_runtime).expanduser().resolve() if configured_runtime else project_root
if not (runtime_root / "companion" / "core.py").is_file():
    raise RuntimeError(f"invalid Companion runtime root: {runtime_root}")
sys.path.insert(0, str(runtime_root))

from companion.core import Companion  # noqa: E402


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if event.get("hook_event_name") != "SessionStart":
            return 0
        companion = Companion(workspace_root)
        brief = companion.session_brief()
        output = {
            "continue": True,
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": brief["text"],
            },
        }
    except Exception as exc:
        output = {
            "continue": True,
            "systemMessage": f"Investment Companion session brief unavailable: {type(exc).__name__}: {exc}",
        }
    print(json.dumps(output, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
