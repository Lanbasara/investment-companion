[Unit]
Description=Investment Companion V5 scheduler tick
After=network-online.target cc-connect.service
Wants=network-online.target
RequiresMountsFor=/home/ghk/investment-home

[Service]
Type=oneshot
WorkingDirectory=/home/ghk/investment-home
Environment="COMPANION_CC_WAKE_CRON=cce0678e"
ExecStart=/home/ghk/investment-home/bin/companion tick --limit 20
ExecStart=/home/ghk/investment-home/bin/companion dispatch --limit 20
TimeoutStartSec=180
Nice=10
