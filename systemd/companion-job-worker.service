[Unit]
Description=Investment Companion V5 deterministic job worker
After=network-online.target
RequiresMountsFor=/home/ghk/investment-home /home/ghk/.local/share/investment-companion

[Service]
Type=oneshot
WorkingDirectory=/home/ghk/investment-home
Environment="COMPANION_ROOT=/home/ghk/investment-home"
Environment="COMPANION_GATE_SCOPE=production"
ExecStart=/home/ghk/investment-home/bin/companion job-work --limit 2
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
Nice=10
